{"batchcomplete":"","query":{"pages":{"72839219":{"pageid":72839219,"ns":6,"title":"File:1955 Porsche 550-1500 RS Spyder (43947054854).jpg","index":6,"imagerepository":"local","imageinfo":[{"size":2836868,"width":5184,"height":3456,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d4/1955_Porsche_550-1500_RS_Spyder_%2843947054854%29.jpg/960px-1955_Porsche_550-1500_RS_Spyder_%2843947054854%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":640,"thumbheight":427,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d4/1955_Porsche_550-1500_RS_Spyder_%2843947054854%29.jpg/1280px-1955_Porsche_550-1500_RS_Spyder_%2843947054854%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d4/1955_Porsche_550-1500_RS_Spyder_%2843947054854%29.jpg/960px-1955_Porsche_550-1500_RS_Spyder_%2843947054854%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":640,"height":427,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d4/1955_Porsche_550-1500_RS_Spyder_%2843947054854%29.jpg/1280px-1955_Porsche_550-1500_RS_Spyder_%2843947054854%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/d/d4/1955_Porsche_550-1500_RS_Spyder_%2843947054854%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:1955_Porsche_550-1500_RS_Spyder_(43947054854).jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=72839219","extmetadata":{"ImageDescription":{"value":"<p>1956 Porsche 550-0073 at the Peterson Museum. The Porsche 550 was a racing sports car produced by Porsche from 1953-56. Inspired by the 356, the 550 was very low to the ground, in order to be efficient for racing. It won 95 races out of 370 races it competed in, in Europe and America. Its successor from 1957 onwards, was the Porsche 718. \nEngine; 1498cc 4 cyl, air cooled horizontal opposed. \nThis car finished second in points in its SCCA class for the 1956 season.\nPerhaps the most famous of the Porsche 550's built was James Dean's, which Dean fatally crashed into Donald Turnupseed's 1950 Ford Custom on September 30, 1955\n</p>\nPhotographed at the Peterson Museum","source":"commons-desc-page"},"Artist":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/people/42220226@N07\">Sicnag</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY 2.0","source":"commons-desc-page","hidden":""}}}]},"132764859":{"pageid":132764859,"ns":6,"title":"File:1955 Porsche 550 Spyder Replica (8971999444).jpg","index":7,"imagerepository":"local","imageinfo":[{"size":811987,"width":3625,"height":2116,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f6/1955_Porsche_550_Spyder_Replica_%288971999444%29.jpg/960px-1955_Porsche_550_Spyder_Replica_%288971999444%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":640,"thumbheight":374,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f6/1955_Porsche_550_Spyder_Replica_%288971999444%29.jpg/1280px-1955_Porsche_550_Spyder_Replica_%288971999444%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f6/1955_Porsche_550_Spyder_Replica_%288971999444%29.jpg/960px-1955_Porsche_550_Spyder_Replica_%288971999444%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":640,"height":374,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f6/1955_Porsche_550_Spyder_Replica_%288971999444%29.jpg/1280px-1955_Porsche_550_Spyder_Replica_%288971999444%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/f/f6/1955_Porsche_550_Spyder_Replica_%288971999444%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:1955_Porsche_550_Spyder_Replica_(8971999444).jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=132764859","extmetadata":{"ImageDescription":{"value":"James Dean was driving a Porsche 550 spyder when he fatally crashed into Donald Turnupseed's 1950 Ford Custom in 1955.","source":"commons-desc-page"},"Artist":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/people/63234672@N04\">Mustang Joe</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"CC0","source":"commons-desc-page","hidden":""}}}]},"175847086":{"pageid":175847086,"ns":6,"title":"File:2000 Porsche Boxster S James Dean 550 Spyder Recreation.jpg","index":1,"imagerepository":"local","imageinfo":[{"size":2633891,"width":4080,"height":2674,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b5/2000_Porsche_Boxster_S_James_Dean_550_Spyder_Recreation.jpg/960px-2000_Porsche_Boxster_S_James_Dean_550_Spyder_Recreation.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":640,"thumbheight":419,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b5/2000_Porsche_Boxster_S_James_Dean_550_Spyder_Recreation.jpg/1280px-2000_Porsche_Boxster_S_James_Dean_550_Spyder_Recreation.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b5/2000_Porsche_Boxster_S_James_Dean_550_Spyder_Recreation.jpg/960px-2000_Porsche_Boxster_S_James_Dean_550_Spyder_Recreation.jpg?utm_source=commons.wikimedia.org&utm_ca