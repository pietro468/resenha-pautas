tory":"local","imageinfo":[{"size":3545276,"width":1239,"height":1752,"pagecount":30,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8b/Temporaliza%C3%A7%C3%A3o_no_Supremo_Tribunal_Federal_-_ADPF_153%2C_Lei_da_Anistia_e_usos_performativos_da_Hist%C3%B3ria.pdf/page1-500px-Temporaliza%C3%A7%C3%A3o_no_Supremo_Tribunal_Federal_-_ADPF_153%2C_Lei_da_Anistia_e_usos_performativos_da_Hist%C3%B3ria.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":400,"thumbheight":566,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8b/Temporaliza%C3%A7%C3%A3o_no_Supremo_Tribunal_Federal_-_ADPF_153%2C_Lei_da_Anistia_e_usos_performativos_da_Hist%C3%B3ria.pdf/page1-960px-Temporaliza%C3%A7%C3%A3o_no_Supremo_Tribunal_Federal_-_ADPF_153%2C_Lei_da_Anistia_e_usos_performativos_da_Hist%C3%B3ria.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8b/Temporaliza%C3%A7%C3%A3o_no_Supremo_Tribunal_Federal_-_ADPF_153%2C_Lei_da_Anistia_e_usos_performativos_da_Hist%C3%B3ria.pdf/page1-500px-Temporaliza%C3%A7%C3%A3o_no_Supremo_Tribunal_Federal_-_ADPF_153%2C_Lei_da_Anistia_e_usos_performativos_da_Hist%C3%B3ria.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":400,"height":566,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8b/Temporaliza%C3%A7%C3%A3o_no_Supremo_Tribunal_Federal_-_ADPF_153%2C_Lei_da_Anistia_e_usos_performativos_da_Hist%C3%B3ria.pdf/page1-960px-Temporaliza%C3%A7%C3%A3o_no_Supremo_Tribunal_Federal_-_ADPF_153%2C_Lei_da_Anistia_e_usos_performativos_da_Hist%C3%B3ria.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/8/8b/Temporaliza%C3%A7%C3%A3o_no_Supremo_Tribunal_Federal_-_ADPF_153%2C_Lei_da_Anistia_e_usos_performativos_da_Hist%C3%B3ria.pdf?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Temporaliza%C3%A7%C3%A3o_no_Supremo_Tribunal_Federal_-_ADPF_153,_Lei_da_Anistia_e_usos_performativos_da_Hist%C3%B3ria.pdf","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=150662017","extmetadata":{"ImageDescription":{"value":"Este artigo visa abordar a rela\u00e7\u00e3o entre hist\u00f3ria e justi\u00e7a a partir do debate recente sobre a Lei da Anistia de 1979 na ocasi\u00e3o da Argui\u00e7\u00e3o de Preceito Fundamental 153 ajuizada pelo Supremo Tribunal Federal em 2010. Levando em considera\u00e7\u00e3o o contexto da justi\u00e7a de transi\u00e7\u00e3o e das mudan\u00e7as na disciplina hist\u00f3rica na segunda metade do s\u00e9culo XX, particularmente o fortalecimento das discuss\u00f5es sobre o tempo na hist\u00f3ria, o trabalho faz uma an\u00e1lise das pr\u00e1ticas de temporaliza\u00e7\u00e3o utilizadas pelos ministros da corte. Ao observar as diversas constru\u00e7\u00f5es temporais que surgem a partir da utiliza\u00e7\u00e3o da hist\u00f3ria e das ferramentas de historiciza\u00e7\u00e3o, se observa que os ministros situam a anistia encerrada no passado e viva no presente, ao mesmo tempo, para justificar a impossibilidade de reinterpretar a lei. Ao fim, o trabalho traz reflex\u00f5es sobre os desafios do fazer hist\u00f3rico em contextos onde a argumenta\u00e7\u00e3o hist\u00f3rica e a temporaliza\u00e7\u00e3o s\u00e3o ferramentas operacionalizadas por outros atores pol\u00edticos.","source":"commons-desc-page"},"Artist":{"value":"Carolina Castelo Branco Cooper","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY 4.0","source":"commons-desc-page","hidden":""}}}]},"162801070":{"pageid":162801070,"ns":6,"title":"File:XI Congresso do Partido Socialista Unificado da Alemanha (Sed) - RDA, Arquivo Nacional (BR DFANBSB IE.0.0.24 (5-9)).pdf","index":3,"imagerep