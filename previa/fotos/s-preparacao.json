ht":1239,"pagecount":183,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/0a/1964_-_imagens_de_um_golpe_de_estado.pdf/page1-960px-1964_-_imagens_de_um_golpe_de_estado.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":640,"thumbheight":640,"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/0a/1964_-_imagens_de_um_golpe_de_estado.pdf/page1-960px-1964_-_imagens_de_um_golpe_de_estado.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":640,"height":640},"url":"https://upload.wikimedia.org/wikipedia/commons/0/0a/1964_-_imagens_de_um_golpe_de_estado.pdf?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:1964_-_imagens_de_um_golpe_de_estado.pdf","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=169876775","extmetadata":{"ImageDescription":{"value":"Apresenta uma linha do tempo detalhada dos acontecimentos que culminaram no golpe militar de 1964 no Brasil, destacando momentos-chave da crise pol\u00edtica e social que levou \u00e0 deposi\u00e7\u00e3o do presidente Jo\u00e3o Goulart. Desde 1963, greves, mobiliza\u00e7\u00f5es conservadoras e campanhas anticomunistas do IPES e IBAD intensificaram a polariza\u00e7\u00e3o pol\u00edtica. Em mar\u00e7o de 1964, a Marcha da Fam\u00edlia com Deus pela Liberdade e o Com\u00edcio das Reformas de Base marcaram o embate entre grupos opostos. A Revolta dos Marinheiros agravou uma crise, levando as tropas do general Olympio Mour\u00e3o Filho a avan\u00e7ar sobre o Rio de Janeiro em 31 de mar\u00e7o. O Congresso declarou vaga a presid\u00eancia, e Ranieri Mazzilli foi nomeado interinamente. Pris\u00f5es, repress\u00e3o e atos institucionais consolidaram o regime. Em 11 de abril, Castello Branco foi eleito presidente, assumindo em 15 de abril, iniciando uma ditadura militar.","source":"commons-desc-page"},"LicenseShortName":{"value":"CC0","source":"commons-desc-page","hidden":""}}}]},"171251839":{"pageid":171251839,"ns":6,"title":"File:A Vida Fluminense (N243).pdf","index":4,"imagerepository":"local","imageinfo":[{"size":4502906,"width":2364,"height":3520,"pagecount":7,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/1c/A_Vida_Fluminense_%28N243%29.pdf/page1-960px-A_Vida_Fluminense_%28N243%29.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":640,"thumbheight":953,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/1c/A_Vida_Fluminense_%28N243%29.pdf/page1-1280px-A_Vida_Fluminense_%28N243%29.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/1c/A_Vida_Fluminense_%28N243%29.pdf/page1-960px-A_Vida_Fluminense_%28N243%29.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":640,"height":953,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/1c/A_Vida_Fluminense_%28N243%29.pdf/page1-1280px-A_Vida_Fluminense_%28N243%29.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/1/1c/A_Vida_Fluminense_%28N243%29.pdf?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:A_Vida_Fluminense_(N243).pdf","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=171251839","extmetadata":{"ImageDescription":{"value":"Edi\u00e7\u00e3o 243 da revista \"A Vida Fluminense\"","source":"commons-desc-page"},"Artist":{"value":"Various","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""}}}]},"161100206":{"pageid":161100206,"