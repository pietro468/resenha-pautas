:"CC BY 3.0 br","source":"commons-desc-page","hidden":""}}}]},"29156805":{"pageid":29156805,"ns":6,"title":"File:Magda Chambriard Leilao Pre-Sal cropped.jpg","index":2,"imagerepository":"local","imageinfo":[{"size":31230,"width":403,"height":375,"thumburl":"https://upload.wikimedia.org/wikipedia/commons/1/14/Magda_Chambriard_Leilao_Pre-Sal_cropped.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","thumbwidth":640,"thumbheight":596,"thumbattribs":{"src":"https://upload.wikimedia.org/wikipedia/commons/1/14/Magda_Chambriard_Leilao_Pre-Sal_cropped.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","decoding":"async","loading":"lazy","width":640,"height":596},"url":"https://upload.wikimedia.org/wikipedia/commons/1/14/Magda_Chambriard_Leilao_Pre-Sal_cropped.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Magda_Chambriard_Leilao_Pre-Sal_cropped.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=29156805","extmetadata":{"ImageDescription":{"value":"A diretora-geral da Ag\u00eancia Nacional do Petr\u00f3leo, G\u00e1s Natural e Biocombust\u00edveis (ANP), Magda Chambriard, abre a 1\u00aa Rodada de Licita\u00e7\u00e3o do Pr\u00e9-Sal","source":"commons-desc-page"},"Artist":{"value":"Fernando Fraz\u00e3o/ABr","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY 3.0 br","source":"commons-desc-page","hidden":""}}}]},"148395090":{"pageid":148395090,"ns":6,"title":"File:Petrobras e quatro empresas estrangeiras vencem primeiro leil\u00e3o do pr\u00e9-sal.webm","index":3,"imagerepository":"local","imageinfo":[{"size":47311840,"width":640,"height":480,"duration":247.001,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/96/Petrobras_e_quatro_empresas_estrangeiras_vencem_primeiro_leil%C3%A3o_do_pr%C3%A9-sal.webm/500px--Petrobras_e_quatro_empresas_estrangeiras_vencem_primeiro_leil%C3%A3o_do_pr%C3%A9-sal.webm.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo","thumbwidth":640,"thumbheight":480,"thumbattribs":[],"url":"https://upload.wikimedia.org/wikipedia/commons/9/96/Petrobras_e_quatro_empresas_estrangeiras_vencem_primeiro_leil%C3%A3o_do_pr%C3%A9-sal.webm?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Petrobras_e_quatro_empresas_estrangeiras_vencem_primeiro_leil%C3%A3o_do_pr%C3%A9-sal.webm","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=148395090","extmetadata":{"ImageDescription":{"value":"ATIVIDADES DO GOVERNO - 21.10.13: O cons\u00f3rcio formado pelas empresas Petrobras (40%), Shell (20%), Total (20%), CNPC (10%) e CNOOC (10%) venceu o 1\u00ba leil\u00e3o do pr\u00e9-sal sob o regime de partilha realizado nesta segunda-feira, no Rio de Janeiro (RJ). Em entrevista \u00e0 imprensa, o ministro de Minas e Energia, Edison Lob\u00e3o, comentou a participa\u00e7\u00e3o de empresas estrangeiras no leil\u00e3o. Para a diretora da Ag\u00eancia Nacional do Petr\u00f3leo (ANP), Magda Chambriard, as empresas estrangeiras ser\u00e3o boas parceiras para o desenvolvimento t\u00e9cnico e econ\u00f4mico da explora\u00e7\u00e3o do Campo de Libra. Magda explicou que contrato de partilha de produ\u00e7\u00e3o \u00e9 uma pr\u00e1tica comum em todo o mundo e que as empresas do cons\u00f3rcio participam desse tipo de contrato em outras situa\u00e7\u00f5es.","source":"commons-desc-page"},"Artist":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.youtube.com/@canalgov\">CanalGov</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY 3.0","source":"commons-desc-page","hidden":""}}}]},"148401757":{"pageid":148401757,"ns":6,"title":"File:Petrobras ser\u00e1 respons\u00e1vel por 40% na explora\u00e7\u00e3o do Campo de Libra.webm","index":5,"imagerepository":"local","imageinfo":[{"size":256590018,"width":640,"height":480,"duration":2227.801,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/0f/Petrobras_ser%C3%A1_respons%C3%A1vel_por_40%25_na_explora%C3%A7%C3%A3o_do_Campo_de_Libra.webm/500px--Petrobras_ser%C3%A1_respons%C3%A1vel_por_40%25_na_explora%C3%A7%C3%A3o_do_Campo_de_Libra.webm.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo","thumbwidth":640,"thumbheight":480,"thumbattribs":[],"url":"https://upload.wikimedia.org/wikipedia/commons/0/0f/Petrobras_ser%C3%A1_respons%C3%A1vel_por_40%25_na_explora%C3%A7%C3%A3o_do_Campo_de_Libra.webm?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Petrobras_ser%C3%A1_respons%C3%A1vel_por_40%25_na_explora%C3%A7%C3%A3o_do_Campo_de_Libra.webm","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=148401757","extmetadata":{"ImageDescription":{"value":"ATIVIDADES DO GOVERNO - 21.10.13: O cons\u00f3rcio formado pelas empresas Petrobras (40%), Shell (20%), Total (20%), CNPC (10%) e CNOOC (10%) foi o vencedor do 1\u00ba leil\u00e3o do pr\u00e9-sal sob o regime de partilha realizado nesta segunda-feira, no Rio de Janeiro (RJ). A \u00e1rea leiloada,  conhecida como Campo de Libra, \u00e9 a maior \u00e1rea petrol\u00edfera j\u00e1 licitada em todos os tempos. Localizado a 170 km do litoral do estado do Rio de Janeiro, na Bacia de Santos; o Campo de Libra possui uma \u00e1rea de cerca de 1,5 mil km\u00b2. Estima-se que o \u00f3leo recuper\u00e1vel varie de 8 a 12 bilh\u00f5es de barris e que a produ\u00e7\u00e3o di\u00e1ria alcance at\u00e9 1,4 milh\u00e3o de barris/dia. Atualmente, toda a produ\u00e7\u00e3o brasileira di\u00e1ria chega a 2 milh\u00f5es de barris de petr\u00f3leo por dia. Participaram da ocasi\u00e3o, a diretora-geral da Ag\u00eancia Nacional do Petr\u00f3leo (ANP), Magda Chambriard, e o ministro de Minas e Energia, Edison Lob\u00e3o. Em entrevista, o ministro ressaltou que a explora\u00e7\u00e3o no Campo de Libra ser\u00e1 um divisor de \u00e1guas no setor petrol\u00edfero.","source":"commons-desc-page"},"Artist":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.youtube.com/@canalgov\">CanalGov</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY 3.0","source":"commons-desc-page","hidden":""}}}]},"112111088":{"pageid":112111088,"ns":6,"title":"File:Sentimento petroleiro, Hist\u00f3ria no Museu da Pessoa (188800).pdf","index":6,"imagerepository":"local","imageinfo":[{"size":127504,"width":1239,"height":1754,"pagecount":11,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e3/Sentimento_petroleiro%2C_Hist%C3%B3ria_no_Museu_da_Pessoa_%28188800%29.pdf/page1-960px-Sentimento_petroleiro%2C_Hist%C3%B3ria_no_Museu_da_Pessoa_%28188800%29.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":640,"thumbheight":906,"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e3/Sentimento_petroleiro%2C_Hist%C3%B3ria_no_Museu_da_Pessoa_%28188800%29.pdf/page1-960px-Sentimento_petroleiro%2C_Hist%C3%B3ria_no_Museu_da_Pessoa_%28188800%29.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":640,"height":906},"url":"https://upload.wikimedia.org/wikipedia/commons/e/e3/Sentimento_petroleiro%2C_Hist%C3%B3ria_no_Museu_da_Pessoa_%28188800%29.pdf?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Sentimento_petroleiro,_Hist%C3%B3ria_no_Museu_da_Pessoa_(188800).pdf","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=112111088","extmetadata":{"ImageDescription":{"value":"Hist\u00f3ria de Eg\u00eddio Silva Filho no Museu da Pessoa.","source":"commons-desc-page"},"Artist":{"value":"Thais Montanari/Museu da Pessoa","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY-SA 4.0","source":"commons-desc-page","hidden":""}}}]}}}}