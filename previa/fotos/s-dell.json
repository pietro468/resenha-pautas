ons/thumb/a/a9/HIVE_Computing_at_FDA_%281767%29_%2814631749676%29.jpg/500px-HIVE_Computing_at_FDA_%281767%29_%2814631749676%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":400,"thumbheight":266,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a9/HIVE_Computing_at_FDA_%281767%29_%2814631749676%29.jpg/960px-HIVE_Computing_at_FDA_%281767%29_%2814631749676%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a9/HIVE_Computing_at_FDA_%281767%29_%2814631749676%29.jpg/500px-HIVE_Computing_at_FDA_%281767%29_%2814631749676%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":400,"height":266,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a9/HIVE_Computing_at_FDA_%281767%29_%2814631749676%29.jpg/960px-HIVE_Computing_at_FDA_%281767%29_%2814631749676%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/a/a9/HIVE_Computing_at_FDA_%281767%29_%2814631749676%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:HIVE_Computing_at_FDA_(1767)_(14631749676).jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=51262022","extmetadata":{"ImageDescription":{"value":"<p>To help FDA understand the significance of data in regulatory submissions that include Next Generation Sequencing (NGS), the agency is supporting the development of a powerful computing technology called High-Performance Integrated Virtual Environment (HIVE).\n</p><p>Shown: Konstantinos Karagiannis, HIVE bioinformatics developer and scientific algorithms specialist, viewing the alignment algorithms portal available on the HIVE webpage. \n</p><p>To learn more about HIVE read this <a rel=\"nofollow\" class=\"external text\" href=\"http://blogs.fda.gov/fdavoice/index.php/2014/07/developing-new-tools-to-support-regulatory-use-of-next-gen-sequencing-data/\">FDA Voice blog</a>.\n</p><p>These photos are free of all copyright restrictions and available for use and redistribution without permission. Credit to the U.S. Food and Drug Administration is appreciated but not required.\n</p><p>Privacy and use information: <a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/people/fdaphotos/\">www.flickr.com/people/fdaphotos/</a>\n</p>\nFDA photo by Michael J. Ermarth","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2014-07-11 13:02","source":"commons-desc-page"},"Artist":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/people/39736050@N02\">The U.S. Food and Drug Administration</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""}}}]},"44922265":{"pageid":44922265,"ns":6,"title":"File:Lobesia bicinctana-Friuli-Venezia Giulia, Pordenone, Vivaro, Magredi dell Cellina-E-MK-12319a.jpg","index":7,"imagerepository":"local","imageinfo":[{"size":67487,"width":1000,"height":669,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/cb/Lobesia_bicinctana-Friuli-Venezia_Giulia%2C_Pordenone%2C_Vivaro%2C_Magredi_dell_Cellina-E-MK-12319a.jpg/500px-Lobesia_bicinctana-Friuli-Venezia_Giulia%2C_Pordenone%2C_Vivaro%2C_Magredi_dell_Cellina-E-MK-12319a.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":400,"thumbheight":268,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/cb/Lobesia_bicinctana-Friuli-Venezia_Giulia%2C_Pordenone%2C_Vivaro%2C_Magredi_dell_Cellina-E-MK-12319a.jpg/960px-Lobesia_bicinctana-Friuli-Venezia_Giulia%2C_Pordenone%2C_Vivaro%2C_Magredi_dell_Cellina-E-MK-12319a.jpg?utm_source=commons.wikimedia.org&utm_campaign