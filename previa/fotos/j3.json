tadata":{"ImageDescription":{"value":"Aboard the International Space Station, NASA astronaut Scott Kelly fielded questions from YouTube creators who sent in video questions asking about aspects of his Year In Space. By doubling the usual length of Kelly's mission to space, researchers hope to better understand how the human body reacts and adapts to long-duration spaceflight. This knowledge is critical as NASA looks toward human journeys deeper into the solar system, including to and from Mars. Participating YouTube creators included Hank Green from Vlogbrothers, Louis from FunForLouis, Emily Graslie at the Brain Scoop, Kyle Hill from the Nerdist, Henry Reich from MinutePhysics, Destin from Smarter Every Day, and Michael from VSauce.","source":"commons-desc-page"},"Artist":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.youtube.com/@ReelNASA\">NASA Johnson</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""}}}]},"155125336":{"pageid":155125336,"ns":6,"title":"File:YouTube video \"Cotton\" by Space Botany (mute).webm","index":9,"imagerepository":"local","imageinfo":[{"size":125042300,"width":1440,"height":1080,"duration":157.023,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/fe/YouTube_video_%22Cotton%22_by_Space_Botany_%28mute%29.webm/960px--YouTube_video_%22Cotton%22_by_Space_Botany_%28mute%29.webm.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo","thumbwidth":640,"thumbheight":480,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/fe/YouTube_video_%22Cotton%22_by_Space_Botany_%28mute%29.webm/1280px--YouTube_video_%22Cotton%22_by_Space_Botany_%28mute%29.webm.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo"},"thumbattribs":[],"url":"https://upload.wikimedia.org/wikipedia/commons/f/fe/YouTube_video_%22Cotton%22_by_Space_Botany_%28mute%29.webm?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content