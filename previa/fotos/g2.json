://thumb.wikimedia.org/wikipedia/commons/thumb/a/a5/Computer_Entertainer_8-6.pdf/page1-960px-Computer_Entertainer_8-6.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":640,"thumbheight":828,"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a5/Computer_Entertainer_8-6.pdf/page1-960px-Computer_Entertainer_8-6.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":640,"height":828},"url":"https://upload.wikimedia.org/wikipedia/commons/a/a5/Computer_Entertainer_8-6.pdf?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Computer_Entertainer_8-6.pdf","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=174558520","extmetadata":{"ImageDescription":{"value":"An issue of Computer Entertainer","source":"commons-desc-page"},"DateTimeOriginal":{"value":"1989-09","source":"commons-desc-page"},"Artist":{"value":"Computer Entertainer (Marylou Badeaux and Celeste Dolan)","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY 4.0","source":"commons-desc-page","hidden":""}}}]},"92331740":{"pageid":92331740,"ns":6,"title":"File:DISSUADING YOUNG POTENTIAL TERRORISTS (IA dissuadingyoungp1094562695).pdf","index":9,"imagerepository":"local","imageinfo":[{"size":1201873,"width":1275,"height":1650,"pagecount":100,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/4f/DISSUADING_YOUNG_POTENTIAL_TERRORISTS_%28IA_dissuadingyoungp1094562695%29.pdf/page1-960px-DISSUADING_YOUNG_POTENTIAL_TERRORISTS_%28IA_dissuadingyoungp1094562695%29.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":640,"thumbheight":828,"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/4f/DISSUADING_YOUNG_POTENTIAL_TERRORISTS_%28IA_dissuadingyoungp1094562695%29.pdf/page1-960px-DISSUADING_YOUNG_POTENTIAL_TERRORISTS_%28IA_dissuadingyoungp1094562695%29.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":640,"height":828},"url":"https://upload.wikimedia.org/wikipedia/commons/4/4f/DISSUADING_YOUNG_POTENTIAL_TERRORISTS_%28IA_dissuadingyoungp1094562695%29.pdf?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:DISSUADING_YOUNG_POTENTIAL_TERRORISTS_(IA_dissuadingyoungp1094562695).pdf","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=92331740","extmetadata":{"Artist":{"value":"<div class=\"fn value\">\nMann, Jeffrey M., Jr.</div>","source":"commons-desc-page"},"ImageDescription":{"value":"<div class=\"description\">\n<p>After the 9/11 attacks, the United States has made many sacrifices to combat terrorism; this includes losing almost 7000 service members in the campaigns of the War on Terror. The United States has spent nearly $3 trillion on counterterrorism funding between fiscal years 2002 and 2017. Instead of being reactive in the fight against terrorism, I examine how to steer the next generation of potential terrorists in another direction. Using mentor programs like Big Brothers Big Sisters and Rancho Cielo as an exploratory proof of concept, I investigate the role proactive mentorship programs have on at-risk youth in a variety of social and culturally diverse settings. At-risk youth that are exposed to mentorship programs throughout the world where they develop sincere and lasting relationships with their mentors will be less vulnerable to being drawn into a gang or terrorist group. Joseph Campbell\u2019s Hero with a Thousand Faces and the hero\u2019s journey serve as the framework of analysis for the mentor programs worldwide and specifically how a mentor inserts him- or herself into the life of an at-risk youth. The examined mentor programs and relationships revealed some positive effects; however, the results are unclear because the programs have only been recently implemented\u2014more time is required to understand lasting results. Not all at-risk youth will benefit from mentorship; however, the programs\u2019 efforts enable some misguided youth the opportunity to live a life free of crime.\n</p>\n<br>Subjects: at-risk youth; mentorship; countering potential terrorists</div>","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""}}}]},"11955889":{"pageid":11955889,"ns":6,"title":"File:Skywalker Ranch Ewok Lake.jpg","index":2,"imagerepository":"local","imageinfo":[{"size":7486687,"width":3888,"height":2591,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/88/Skywalker_Ranch_Ewok_Lake.jpg/960px-Skywalker_Ranch_Ewok_Lake.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":640,"thumbheight":427,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/88/Skywalker_Ranch_Ewok_Lake.jpg/1280px-Skywalker_Ranch_Ewok_Lake.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/88/Skywalker_Ranch_Ewok_Lake.jpg/960px-Skywalker_Ranch_Ewok_Lake.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":640,"height":427,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/88/Skywalker_Ranch_Ewok_Lake.jpg/1280px-Skywalker_Ranch_Ewok_Lake.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/8/88/Skywalker_Ranch_Ewok_Lake.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Skywalker_Ranch_Ewok_Lake.jpg","descriptionshorturl":"https://commons.w