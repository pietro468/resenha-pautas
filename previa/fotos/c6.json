azy","width":640,"height":905},"url":"https://upload.wikimedia.org/wikipedia/commons/d/d0/Internet_Health_Report_2020.pdf?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Internet_Health_Report_2020.pdf","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=99603866","extmetadata":{"ImageDescription":{"value":"Internet Health Report 2020","source":"commons-desc-page"},"Artist":{"value":"Mozilla Foundation","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY 4.0","source":"commons-desc-page","hidden":""}}}]},"127552079":{"pageid":127552079,"ns":6,"title":"File:Lived experiences. The interrelationship between ethnicity, class, gender, indigeneity, conflict, and internet access.pdf","index":5,"imagerepository":"local","imageinfo":[{"size":255632,"width":1275,"height":1650,"pagecount":9,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e1/Lived_experiences._The_interrelationship_between_ethnicity%2C_class%2C_gender%2C_indigeneity%2C_conflict%2C_and_internet_access.pdf/page1-960px-Lived_experiences._The_interrelationship_between_ethnicity%2C_class%2C_gender%2C_indigeneity%2C_conflict%2C_and_internet_access.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":640,"thumbheight":828,"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e1/Lived_experiences._The_interrelationship_between_ethnicity%2C_class%2C_gender%2C_indigeneity%2C_conflict%2C_and_internet_access.pdf/page1-960px-Lived_experiences._The_interrelationship_between_ethnicity%2C_class%2C_gender%2C_indigeneity%2C_conflict%2C_and_internet_access.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":640,"height":828},"url":"https://upload.wikimedia.org/wikipedia/commons/e/e1/Lived_experiences._The_interrelationship_between_ethnicity%2C_class%2C_gender%2C_indigeneity%2C_conflict%2C_and_internet_access.pdf?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Lived_experiences._The_interrelationship_between_ethnicity,_class,_gender,_indigeneity,_conflict,_and_internet_access.pdf","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=127552079","extmetadata":{"ImageDescription":{"value":"This learning module is a part of the <b>Community Toolkit for Greater Diversity</b>. \n<p>(Project page: <a class=\"external text\" href=\"https://meta.wikimedia.org/wiki/Community%20Toolkit%20For%20Greater%20Diversity\">https://meta.wikimedia.org/wiki/Community_Toolkit_For_Greater_Diversity</a>)\n</p><p>It guides the reader about identities at the intersection of ethnicity, economic class, gender, and indigeneity, coupled with the experience of living in a place strained by prolonged armed conflict, and how all of these affect access to the Internet.\n</p><p>This module was first published in February 2019 on the website Wikiinclusivity.in, which is now defunct.\n</p><p>The project was funded by a Project Grant of the Wikimedia Foundation (2018-19).\n</p><p>All the modules of the Community Toolkit for Greater Diversity (CTGD): <a href=\"//commons.wikimedia.org/wiki/Category:Community_Toolkit_for_Greater_Diversity\" title=\"Category:Community Toolkit for Greater Diversity\">Category:Community_Toolkit_for_Greater_Diversity</a>\n</p><p>This file was uploaded by Rohini, who was the module editor, reviewer, and Project Co-lead, after obtaining email approval from the author <b>Mary Beth Sanate</b>.\n</p>\nNames and bios of the team: <a class=\"external free\" href=\"https://meta.wikimedia.org/wiki/Grants:Project/Chinmayisk/Community_toolkit_for_Greater_Diversity/Profile\">https://meta.wikimedia.org/wiki/Grants:Project/Chinmayisk/Community_toolkit_for_Greater_Diversity/Profile</a>","source":"commons-desc-page"},"Artist":{"value