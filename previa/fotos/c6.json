dth":640,"height":828},"url":"https://upload.wikimedia.org/wikipedia/commons/0/0a/Beyond_Earth_by_Asif_Siddiqi_%282018%29.pdf?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Beyond_Earth_by_Asif_Siddiqi_(2018).pdf","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=118044013","extmetadata":{"ImageDescription":{"value":"<i>Beyond Earth: A Chronicle of Deep Space Exploration</i> \u2014 \"Humans have used tools since our species arose hundreds of thousands of years ago. But our ability to send specialized tools, robotic spacecraft, into the heavens and leave our mark on the cosmos has spanned only the last 60 years. This book is a chronicle of our attempts to send these robotic travelers beyond Earth orbit, to the Moon, to other planets and their moons, to the Sun, to comets, to minor planets, to dwarf planets, and ultimately beyond the solar system. This remarkable international chronology goes from the early Cold War superpower competition to more recent and compelling scientific quests. From Sputnik to Cassini to Mars rovers and many more, this book is filled with many technical details and also stories of incredible hardships and successes of robotic space exploration.\"","source":"commons-desc-page"},"Artist":{"value":"Asif A. Siddiqi","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""}}}]},"149578598":{"pageid":149578598,"ns":6,"title":"File:Carbon dots functionalized papers for high-throughput sensing of 4-chloroethcathinone and its analogues in crime sites.pdf","index":6,"imagerepository":"local","imageinfo":[{"size":855692,"width":1085,"height":1575,"pagecount":11,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/53/Carbon_dots_functionalized_papers_for_high-throughput_sensing_of_4-chloroethcathinone_and_its_analogues_in_crime_sites.pdf/page1-960px-Carbon_dots_functionalized_